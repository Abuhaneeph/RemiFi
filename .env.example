# Render agent API (.env on Render dashboard). VPS uses .env.vps.example instead.
CELO_RPC_URL=https://forno.celo.org
CELO_CHAIN_ID=42220
AGENT_PRIVATE_KEY=

OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=remifi_bot
MIN_SEND_BALANCE_USD=1
ANTHROPIC_API_KEY=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=

DAILY_TRANSFER_LIMIT_USD=500
SINGLE_TRANSFER_LIMIT_USD=200
REQUIRE_CONFIRMATION_ABOVE_USD=100
SLIPPAGE_BPS=50

AGENT_API_PORT=8787
AGENT_API_KEY=
# Production: https://remifi.xyz — local dev also allows localhost:3000 in CORS
WEB_ORIGIN=https://remifi.xyz
DEMO_RECIPIENT_ADDRESS=
REMIFI_VAULT_ADDRESS=

AGENT_ID=
AGENT_URI=
AGENT_NAME=Remifi
AGENT_DESCRIPTION=Send cross border remittances on Celo using stablecoins. Talk in English, Spanish, Portuguese, or French. Remifi quotes Mento routes, compares fees against banks, and settles on chain in seconds. remifi.xyz · api.remifi.xyz · Telegram @remifi_bot
AGENT_IMAGE=https://remifi.xyz/assets/remifi-agent.png
PUBLIC_BASE_URL=https://remifi.xyz
PUBLIC_AGENT_API_URL=https://api.remifi.xyz

X402_ENABLED=false
X402_PRICE_USD=0.01
X402_NETWORK=celo
X402_TOKEN=USDC
# thirdweb dashboard → Project → Settings → Secret key (same project as NEXT_PUBLIC_THIRDWEB_CLIENT_ID)
# Enables real x402 verify/settle via thirdweb facilitator on Render
THIRDWEB_SECRET_KEY=

NODE_ENV=development
LOG_LEVEL=info
DATA_DIR=./data
