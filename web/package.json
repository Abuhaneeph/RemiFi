{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev --turbopack",
    "dev:clean": "node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true,maxRetries:5,retryDelay:200})}catch(e){}\" && next dev --webpack",
    "dev:clean:turbo": "node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true,maxRetries:5,retryDelay:200})}catch(e){}\" && next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@moonpay/moonpay-react": "^1.10.6",
    "@neondatabase/serverless": "^1.1.0",
    "next": "16.2.7",
    "postcss": "^8.5.15",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "thirdweb": "^5.120.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4.3.0",
    "typescript": "^5"
  },
  "overrides": {
    "use-sync-external-store": "1.4.0",
    "valtio": {
      "use-sync-external-store": "1.4.0"
    }
  }
}
