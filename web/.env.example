# Next.js reads env from web/ only (not the repo root .env).
# Copy to web/.env.local for local dev, or set in your web host dashboard for production.

NEXT_PUBLIC_AGENT_API_URL=http://localhost:8787
# Must match AGENT_API_KEY in the repo root .env / Render API service
NEXT_PUBLIC_AGENT_API_KEY=

NEXT_PUBLIC_CELO_EXPLORER=https://celoscan.io
NEXT_PUBLIC_CELO_CHAIN_ID=42220
# NEXT_PUBLIC_CELO_RPC_URL=https://forno.celo.org

NEXT_PUBLIC_THIRDWEB_CLIENT_ID=
# Set false if smart-wallet gas sponsorship fails locally (thirdweb dashboard billing)
# NEXT_PUBLIC_THIRDWEB_SPONSOR_GAS=false
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=remifi_bot

# Neon Postgres — get from https://console.neon.tech → Connection string
DATABASE_URL=

# OpenClaw gateway (Telegram-parity smart chat) — server-side only
# OPENCLAW_GATEWAY_URL=https://your-vps:18789
# OPENCLAW_GATEWAY_TOKEN=
