# OpenClaw VPS — chat gateway only (copy to .env on Hostinger).
# The agent runs on Render (api.remifi.xyz). This machine does NOT sign txs.
# See deploy/DEPLOY.md

# ── Connection to the agent (required) ──
PUBLIC_AGENT_API_URL=https://api.remifi.xyz
AGENT_API_KEY=your-shared-api-key

# ── OpenClaw chat (required) ──
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=

# ── Optional ──
REQUIRE_CONFIRMATION_ABOVE_USD=100

# ── Do NOT set on VPS (agent on Render owns these) ──
# AGENT_PRIVATE_KEY=
# CELO_RPC_URL=
# DATA_DIR=
# TWILIO_*=

# ── systemd example (/etc/systemd/system/openclaw-remifi.service) ──
# [Unit]
# Description=Remifi OpenClaw Gateway
# After=network.target
#
# [Service]
# Type=simple
# User=remifi
# WorkingDirectory=/home/remifi/RemitClaw
# EnvironmentFile=/home/remifi/RemitClaw/.env
# ExecStart=/usr/bin/openclaw gateway run
# Restart=always
#
# [Install]
# WantedBy=multi-user.target
