# VPS (OpenClaw gateway only). Copy to .env on the Hostinger box:
#   cp .env.vps.example .env
#
# Do NOT set AGENT_PRIVATE_KEY, CELO_RPC_URL, DATA_DIR, or Twilio here.
# Signing and /data live on Render (api.remifi.xyz).

# --- Required: point OpenClaw at THIS repo (loads AGENTS.md, remifi skill) ---
OPENCLAW_CONFIG_PATH=/var/projects/RemiFi/openclaw.json

# --- Agent API (thin client → Render) ---
PUBLIC_AGENT_API_URL=https://api.remifi.xyz
AGENT_API_KEY=

# --- Claude for OpenClaw conversations ---
ANTHROPIC_API_KEY=

# --- Telegram bot (BotFather) ---
TELEGRAM_BOT_TOKEN=

# --- Optional ---
REQUIRE_CONFIRMATION_ABOVE_USD=100

# --- systemd example (/etc/systemd/system/openclaw.service) ---
# [Unit]
# Description=OpenClaw Gateway
# After=network.target
#
# [Service]
# WorkingDirectory=/var/projects/RemiFi
# ExecStart=/usr/bin/openclaw gateway run
# Restart=always
# EnvironmentFile=/var/projects/RemiFi/.env
#
# [Install]
# WantedBy=multi-user.target
#
# Web Pay on remifi.xyz needs chatCompletions (enabled in repo openclaw.json).
# After git pull or config change:
#   openclaw config get gateway.http.endpoints.chatCompletions.enabled
#   sudo systemctl restart openclaw
#   curl -s https://claw.mujaadevs.cloud/v1/chat/completions  # should not be 404
#
# After editing .env or openclaw.json:
#   sudo systemctl daemon-reload
#   sudo systemctl restart openclaw
#
# Verify config + workspace:
#   openclaw config file
#   openclaw config get agents.list
#   openclaw doctor
